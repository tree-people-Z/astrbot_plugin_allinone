{
  "timezone": {
    "description": "时区偏移（小时）",
    "type": "int",
    "hint": "用于判定自然日与每日重置，默认 8 即 UTC+8。",
    "default": 8
  },
  "request_timeout": {
    "description": "网络请求超时（秒）",
    "type": "int",
    "default": 15
  },
  "http_proxy": {
    "description": "网络代理地址",
    "type": "string",
    "hint": "如 http://127.0.0.1:7890，留空表示不使用代理。",
    "default": ""
  },
  "qq_buttons_enable": {
    "description": "QQ 官方消息交互按钮",
    "type": "bool",
    "hint": "在 QQ 官方群聊/C2C 的插件结果下展示原生按钮；需要平台允许自定义 Markdown 和 keyboard。按钮独立于传统指令开关。",
    "default": true
  },
  "qq_button_ttl": {
    "description": "QQ 按钮有效期（秒）",
    "type": "int",
    "hint": "默认 600 秒，范围 30～3600。按钮绑定发起人及聊天来源，使用一次后失效；重启或跨自然日后失效。",
    "default": 600
  },
  "command_enable": {
    "description": "启用传统指令",
    "type": "bool",
    "hint": "默认关闭，改为自然语言驱动；开启后保留 /签到 /点歌 等指令作为兜底。",
    "default": false
  },
  "llm_capability_hint": {
    "description": "向 LLM 注入本插件能力提示",
    "type": "bool",
    "hint": "开启后会在每轮对话注入一小段动态上下文，让模型明确可用能力。",
    "default": true
  },
  "checkin_enable": {
    "description": "启用签到模块",
    "type": "bool",
    "default": true
  },
  "fortune_tiers": {
    "description": "签到吉凶运势等级（权重相对概率，积分区间）",
    "type": "template_list",
    "hint": "签到先抽等级，再在该等级积分区间内随机。留空则使用内置 9 级默认值。新版奖励逐档递增，大吉 1501～3000，超大吉固定 10000（基础积分，另计连签加成）；已有配置需手动更新或清空等级列表以使用内置值。",
    "default": [
      {"__template_key": "tier", "name": "大凶", "weight": 3, "min_points": 5, "max_points": 25},
      {"__template_key": "tier", "name": "凶", "weight": 7, "min_points": 26, "max_points": 75},
      {"__template_key": "tier", "name": "小凶", "weight": 10, "min_points": 76, "max_points": 150},
      {"__template_key": "tier", "name": "末吉", "weight": 15, "min_points": 151, "max_points": 250},
      {"__template_key": "tier", "name": "小吉", "weight": 20, "min_points": 251, "max_points": 500},
      {"__template_key": "tier", "name": "中吉", "weight": 20, "min_points": 501, "max_points": 900},
      {"__template_key": "tier", "name": "吉", "weight": 15, "min_points": 901, "max_points": 1500},
      {"__template_key": "tier", "name": "大吉", "weight": 8, "min_points": 1501, "max_points": 3000},
      {"__template_key": "tier", "name": "超大吉", "weight": 2, "min_points": 10000, "max_points": 10000}
    ],
    "templates": {
      "tier": {
        "name": "运势等级",
        "display_item": "name",
        "items": {
          "name": {"description": "等级名称", "type": "string", "default": "小吉"},
          "weight": {"description": "权重（相对概率）", "type": "int", "default": 10},
          "min_points": {"description": "最低积分", "type": "int", "default": 1},
          "max_points": {"description": "最高积分", "type": "int", "default": 10}
        }
      }
    }
  },
  "streak_bonus_per_day": {
    "description": "连续签到每日额外加成积分",
    "type": "int",
    "default": 10
  },
  "streak_bonus_cap": {
    "description": "连续签到加成上限",
    "type": "int",
    "default": 100
  },
  "wife_enable": {
    "description": "启用每日老婆模块",
    "type": "bool",
    "default": true
  },
  "waifu_source": {
    "description": "每日老婆图源",
    "type": "string",
    "options": ["manshuo", "local"],
    "default": "manshuo"
  },
  "local_wife_paths": {
    "description": "本地老婆图片路径",
    "type": "list",
    "hint": "可填写图片文件或目录路径；目录会递归扫描 jpg/jpeg/png/gif/webp/bmp 文件。waifu_source=local 时使用。",
    "default": []
  },
  "local_wife_name_source": {
    "description": "本地老婆人物名称来源",
    "type": "string",
    "options": ["folder", "filename", "none"],
    "hint": "folder：取图片所在角色文件夹名（自动去掉前导序号，如 3_安和昴 → 安和昴）；filename：用图片文件名；none：不显示名称。",
    "default": "folder"
  },
  "local_wife_name_llm": {
    "description": "用大模型从文件夹名提取角色名",
    "type": "bool",
    "hint": "仅名称来源为 folder 时生效；开启后交由默认大模型从文件夹名提取角色名，失败或超时则回退为去掉序号的结果，成功结果会缓存。",
    "default": false
  },
  "local_wife_name_llm_timeout": {
    "description": "大模型提取名称超时（秒）",
    "type": "int",
    "hint": "仅 local_wife_name_llm 开启时生效，超时回退为去掉序号的结果。",
    "default": 20
  },
  "change_wife_cost": {
    "description": "换老婆消耗积分",
    "type": "int",
    "default": 60
  },
  "change_wife_limit": {
    "description": "每日换老婆次数上限（0 不限）",
    "type": "int",
    "default": 2
  },
  "music_enable": {
    "description": "启用点歌模块",
    "type": "bool",
    "default": true
  },
  "music_default_platform": {
    "description": "点歌音源",
    "type": "string",
    "options": ["qq"],
    "default": "qq"
  },
  "music_agg_base_url": {
    "description": "多音源聚合接口地址",
    "type": "string",
    "default": "https://music.txqq.pro/"
  },
  "music_song_limit": {
    "description": "搜索结果数量",
    "type": "int",
    "default": 5
  },
  "music_select_mode": {
    "description": "选歌展示方式",
    "type": "string",
    "options": ["text", "image", "single"],
    "default": "text"
  },
  "music_record_link": {
    "description": "卡片失败后尝试发送语音",
    "type": "bool",
    "hint": "普通卡片和签名卡片都未发送成功时，尝试发送语音；失败后发送文本链接。",
    "default": false
  },
  "music_send_card": {
    "description": "发送 QQ 音乐卡片",
    "type": "bool",
    "hint": "仅 QQ OneBot：配置 API Key 时优先发送签名卡片，避免部分 QQ 客户端显示“发送者版本过低”；否则尝试普通卡片，最后回退语音或文本。",
    "default": true
  },
  "music_enable_comments": {
    "description": "发送后附加热评",
    "type": "bool",
    "default": false
  },
  "music_enable_lyrics": {
    "description": "发送后附带歌词预览",
    "type": "bool",
    "hint": "默认关闭；仍可用 /查歌词 或自然语言单独查询歌词。",
    "default": false
  },
  "music_nodejs_base_url": {
    "description": "网易云 NodeJS 接口地址（可选）",
    "type": "string",
    "default": ""
  },
  "music_card_api_key": {
    "description": "签名卡片 API Key（可选）",
    "type": "string",
    "hint": "apii.xianyuw.cn 的 API Key；普通音乐卡片失败时用于请求签名 Ark 卡片。",
    "default": "",
    "secret": true
  },
  "admin_enable": {
    "description": "启用群管模块（仅 QQ）",
    "type": "bool",
    "default": true
  },
  "admin_superusers": {
    "description": "群管超级管理员（QQ号列表）",
    "type": "list",
    "default": []
  },
  "admin_ban_default": {
    "description": "默认禁言时长（秒）",
    "type": "int",
    "default": 300
  },
  "admin_recall_default": {
    "description": "默认撤回条数",
    "type": "int",
    "default": 10
  },
  "admin_builtin_badwords": {
    "description": "启用内置违禁词检测",
    "type": "bool",
    "default": true
  },
  "admin_spam_enable": {
    "description": "启用刷屏检测",
    "type": "bool",
    "default": true
  },
  "admin_spam_duration": {
    "description": "刷屏禁言时长（秒，0 关闭）",
    "type": "int",
    "default": 0
  },
  "admin_advanced_enable": {
    "description": "启用群管进阶功能（头衔/上管/群名/群头像/精华）",
    "type": "bool",
    "default": false
  }
}
